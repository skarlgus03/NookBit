{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "NOOKBIT_BUILD_TESTS": "ON",
        "NOOKBIT_BUILD_QT_APP": "ON",
        "NOOKBIT_REQUIRE_QT_APP": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NOOKBIT_BUILD_TESTS": "ON",
        "NOOKBIT_BUILD_QT_APP": "ON",
        "NOOKBIT_REQUIRE_QT_APP": "ON"
      }
    },
    {
      "name": "core",
      "inherits": "dev",
      "displayName": "Core without Qt",
      "binaryDir": "${sourceDir}/out/build/core",
      "cacheVariables": {
        "NOOKBIT_BUILD_QT_APP": "OFF",
        "NOOKBIT_REQUIRE_QT_APP": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "core", "configurePreset": "core" },
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "package-release",
      "configurePreset": "release",
      "targets": ["nookbit_package"]
    }
  ],
  "testPresets": [
    { "name": "core", "configurePreset": "core", "output": { "outputOnFailure": true } },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

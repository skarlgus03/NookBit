{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nookbit.local/schemas/settings.schema.json",
  "title": "NookBit Settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "paths", "organization", "watch", "safety", "history", "character"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["homeRoot", "watchFolders", "excludePatterns"],
      "properties": {
        "homeRoot": { "type": "string", "minLength": 1 },
        "watchFolders": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "recursive", "enabled"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "recursive": { "type": "boolean" },
              "enabled": { "type": "boolean" }
            }
          }
        },
        "excludePatterns": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collisionPolicy", "multiMatchPolicy", "unmatchedPolicy", "crossVolumePolicy"],
      "properties": {
        "collisionPolicy": { "enum": ["rename", "skip", "abort"] },
        "multiMatchPolicy": { "enum": ["first_match", "abort"] },
        "unmatchedPolicy": { "enum": ["leave_in_place", "abort"] },
        "crossVolumePolicy": { "enum": ["block", "copy_keep_source"] }
      }
    },
    "watch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["debounceMs", "rescanIntervalMinutes", "promptFileCount"],
      "properties": {
        "debounceMs": { "type": "integer", "minimum": 250, "maximum": 60000 },
        "rescanIntervalMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "promptFileCount": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvalRequired", "permanentDeleteAllowed", "silentOverwriteAllowed", "followReparsePoints", "integrityLevel"],
      "properties": {
        "approvalRequired": { "const": true },
        "permanentDeleteAllowed": { "const": false },
        "silentOverwriteAllowed": { "const": false },
        "followReparsePoints": { "const": false },
        "integrityLevel": { "enum": ["standard", "strict"] }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retentionDays", "diagnosticLogDays"],
      "properties": {
        "retentionDays": { "type": "integer", "minimum": 30, "maximum": 3650 },
        "diagnosticLogDays": { "type": "integer", "minimum": 1, "maximum": 365 }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "alwaysOnTop", "doNotDisturb"],
      "properties": {
        "enabled": { "type": "boolean" },
        "alwaysOnTop": { "type": "boolean" },
        "doNotDisturb": { "enum": ["auto", "on", "off"] }
      }
    }
  }
}

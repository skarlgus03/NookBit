{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NookBit Rule Tree",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ruleSetId", "version", "nodes"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "ruleSetId": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
    "version": { "type": "string", "format": "date-time" },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "globalOtherwise": { "$ref": "#/$defs/destination" }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "enabled"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
        "enabled": { "type": "boolean" },
        "otherwise": { "const": true },
        "when": { "$ref": "#/$defs/condition" },
        "destination": { "$ref": "#/$defs/destination" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "extensions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-zA-Z0-9]+$" }
        },
        "fileNameGlobs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "minimumBytes": { "type": "integer", "minimum": 0 },
        "maximumBytes": { "type": "integer", "minimum": 0 },
        "greaterThanBytes": { "type": "integer", "minimum": 0 },
        "minimumAgeDays": { "type": "integer", "minimum": 0 },
        "maximumAgeDays": { "type": "integer", "minimum": 0 }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "collisionPolicy"],
      "properties": {
        "path": {
          "type": "string", "minLength": 1,
          "not": { "pattern": "(^[A-Za-z]:)|(^[/\\\\])|(^|[/\\\\])\\.\\.([/\\\\]|$)" }
        },
        "collisionPolicy": { "enum": ["inherit", "rename", "skip", "abort"] }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nookbit:imagepack:1",
  "title": "NookBit ImagePack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packType", "id", "name", "version", "display", "sources", "frames", "animations", "bindings"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "packType": { "const": "imagepack" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "author": { "type": "string" },
    "bubble": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "attachment": { "$ref": "#/$defs/point" },
        "pivot": {
          "type": "object", "additionalProperties": false, "required": ["x", "y"],
          "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 } }
        },
        "skin": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "default" } } },
            {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "sourceId", "size", "textRect", "actionRect"],
              "properties": {
                "kind": { "const": "image" }, "sourceId": { "$ref": "#/$defs/id" },
                "size": { "$ref": "#/$defs/size" },
                "textRect": { "$ref": "#/$defs/bubbleRect" }, "actionRect": { "$ref": "#/$defs/bubbleRect" }
              }
            }
          ]
        }
      }
    },
    "display": {
      "type": "object", "additionalProperties": false,
      "required": ["referenceSize", "pixelsPerUnit", "pivot", "filtering"],
      "properties": {
        "referenceSize": { "$ref": "#/$defs/size" },
        "pixelsPerUnit": { "type": "number", "exclusiveMinimum": 0 },
        "pivot": { "$ref": "#/$defs/point" },
        "filtering": { "enum": ["nearest", "linear"] }
      }
    },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "frames": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "sourceId", "region"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "sourceId": { "$ref": "#/$defs/id" },
          "region": { "$ref": "#/$defs/region" },
          "pivot": { "$ref": "#/$defs/point" },
          "pixelsPerUnit": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "animations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "loop", "steps"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "loop": { "type": "boolean" },
          "steps": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["frameId", "durationMs"],
              "properties": {
                "frameId": { "$ref": "#/$defs/id" },
                "durationMs": { "type": "integer", "minimum": 16, "maximum": 60000 }
              }
            }
          }
        }
      }
    },
    "bindings": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["cueId", "animationId"],
        "properties": {
          "cueId": { "$ref": "#/$defs/id" },
          "animationId": { "$ref": "#/$defs/id" }
        }
      }
    }
  },
  "$defs": {
    "bubbleRect": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }
      }
    },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "point": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "size": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height"],
      "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "grid": {
      "type": "object", "additionalProperties": false,
      "required": ["frameWidth", "frameHeight", "columns", "rows"],
      "properties": {
        "frameWidth": { "type": "integer", "minimum": 1 },
        "frameHeight": { "type": "integer", "minimum": 1 },
        "columns": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1 }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "kind", "file"],
          "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "image" }, "file": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "kind", "file"],
          "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "atlas" }, "file": { "type": "string", "minLength": 1 }, "grid": { "$ref": "#/$defs/grid" } }
        }
      ]
    },
    "region": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "image" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "index"], "properties": { "type": { "const": "cell" }, "index": { "type": "integer", "minimum": 0 } } },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "x", "y", "width", "height"],
          "properties": {
            "type": { "const": "rect" },
            "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 },
            "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NookBit Character Presentation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sheets", "animations", "cues"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sheets": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "image", "frameWidth", "frameHeight", "columns", "rows"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "image": { "type": "string", "minLength": 1 },
          "frameWidth": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "frameHeight": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "columns": { "type": "integer", "minimum": 1, "maximum": 1024 },
          "rows": { "type": "integer", "minimum": 1, "maximum": 1024 }
        }
      }
    },
    "animations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "sheetId", "frames", "frameDurationMs", "loop"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "sheetId": { "type": "string", "minLength": 1 },
          "frames": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 1048575 } },
          "frameDurationMs": { "type": "integer", "minimum": 16, "maximum": 60000 },
          "loop": { "type": "boolean" }
        }
      }
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "message"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "message": { "type": "string" },
          "animationId": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

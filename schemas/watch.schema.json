{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NookBit Watch Settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "folder", "enabled", "recursive", "rescanIntervalMinutes", "combination", "conditions", "excludePatterns"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "folder": { "type": "string", "minLength": 1 },
    "enabled": { "type": "boolean" },
    "recursive": { "type": "boolean" },
    "rescanIntervalMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
    "combination": { "enum": ["all", "any"] },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "threshold"],
        "oneOf": [
          { "properties": { "type": { "enum": ["file_count", "total_size_mib", "oldest_age_minutes"] } },
            "not": { "required": ["unit"] } },
          { "required": ["unit"], "properties": { "type": { "const": "total_size" } } }
        ],
        "properties": {
          "type": { "enum": ["file_count", "total_size_mib", "oldest_age_minutes", "total_size"] },
          "unit": { "enum": ["KB", "MB", "GB", "MiB"] },
          "threshold": { "type": "integer", "minimum": 1, "maximum": 1000000 }
        }
      }
    },
    "excludePatterns": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

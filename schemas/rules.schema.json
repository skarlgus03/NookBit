{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nookbit.local/schemas/rules.schema.json",
  "title": "NookBit Rule Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ruleSetId", "version", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ruleSetId": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
    "version": { "type": "string", "format": "date-time" },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "enabled", "priority", "when", "then"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
        "enabled": { "type": "boolean" },
        "priority": { "type": "integer", "minimum": -100000, "maximum": 100000 },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "extensions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-zA-Z0-9]+$" }
            },
            "fileNameGlobs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "minimumBytes": { "type": "integer", "minimum": 0 },
            "maximumBytes": { "type": "integer", "minimum": 0 },
            "minimumAgeDays": { "type": "integer", "minimum": 0 },
            "maximumAgeDays": { "type": "integer", "minimum": 0 }
          }
        },
        "then": {
          "type": "object",
          "additionalProperties": false,
          "required": ["destination", "collisionPolicy"],
          "properties": {
            "destination": {
              "type": "string",
              "minLength": 1,
              "not": { "pattern": "(^[A-Za-z]:)|(^[/\\\\])|(^|[/\\\\])\\.\\.([/\\\\]|$)" }
            },
            "collisionPolicy": { "enum": ["inherit", "rename", "skip", "abort"] }
          }
        }
      }
    }
  }
}

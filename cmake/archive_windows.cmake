# 생성된 배포 폴더만 압축하고 완료한 ZIP의 체크섬을 별도로 기록한다.
get_filename_component(expected_package "${CMAKE_CURRENT_LIST_DIR}/../out/package/NookBit-Release" ABSOLUTE)
file(REAL_PATH "${NOOKBIT_PACKAGE_DIR}" package_root)
if(NOT package_root STREQUAL expected_package OR NOT EXISTS "${package_root}/nookbit.exe")
  message(FATAL_ERROR "Archive input must be the generated NookBit Release package.")
endif()
if(NOT NOOKBIT_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$")
  message(FATAL_ERROR "Invalid NookBit archive version.")
endif()
foreach(required README.txt version.json imagepacks/nmoo/imagepack.json Qt6Core.dll platforms/qwindows.dll)
  if(NOT EXISTS "${package_root}/${required}")
    message(FATAL_ERROR "Required package file is missing: ${required}")
  endif()
endforeach()
file(READ "${package_root}/version.json" version_document)
string(JSON package_version GET "${version_document}" version)
if(NOT package_version STREQUAL NOOKBIT_VERSION)
  message(FATAL_ERROR "Package metadata does not match the requested archive version.")
endif()
get_filename_component(archive_directory "${package_root}" DIRECTORY)
get_filename_component(package_name "${package_root}" NAME)
set(archive_name "NookBit-${NOOKBIT_VERSION}-Windows-x64.zip")
set(archive_path "${archive_directory}/${archive_name}")
# 실패한 압축이 기존의 완성된 ZIP을 덮지 않도록 임시 파일을 먼저 만든다.
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${archive_path}.tmp" --format=zip "${package_name}"
  WORKING_DIRECTORY "${archive_directory}" RESULT_VARIABLE archive_result)
if(NOT archive_result EQUAL 0)
  message(FATAL_ERROR "Creating the Windows ZIP failed: ${archive_result}")
endif()
file(RENAME "${archive_path}.tmp" "${archive_path}")
file(SHA256 "${archive_path}" archive_hash)
file(WRITE "${archive_path}.sha256" "${archive_hash}  ${archive_name}\n")
message(STATUS "NookBit archive: ${archive_path}")
